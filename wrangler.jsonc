{
  // The Worker that serves the site. Static pages come from public/ and are
  // matched first; anything with no file behind it falls through to
  // src/index.js, which is where /api/fitting and /leads live.
  "name": "lagente-studio",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },

  // Where the fitting requests land.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lagente-leads",
      "database_id": "914f1e44-8d57-4b65-9dd7-d494c68e53d4"
    }
  ]
}
